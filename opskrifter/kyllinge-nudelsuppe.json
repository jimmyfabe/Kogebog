  "@type": "Recipe",
  "name": "Kyllinge-nudelsuppe",
  "description": "Hurtig suppe med kylling, suppeurter, ærter, gulerødder, nudler og majs.",
  "image": "grafik/ret-kyllinge-nudelsuppe.webp",
  "inLanguage": "da",
  "recipeYield": "4 personer",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "½ dåse majs",
    "15 dl vand",
    "2 grøntsagsbouillonterninger",
    "250 g kyllingebryst",
    "300 g frosne suppeurter",
    "400 g frosne ærter og gulerødder",
    "200 g nudler",
    "½ tsk salt"
  ],
  "tool": ["dåseåbner", "si", "stor gryde med låg", "grydeske", "tallerken", "2 gafler"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Hæld majsen i en si.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["majs"], "note": "Den voksne åbner dåsen: kanten er skarp. Lad vandet løbe fra. Brug halvdelen." } },
    { "@type": "HowToStep", "text": "Hæld vand i en stor gryde.", "tumbi": { "verbum": "haelde", "ikoner": ["vand"], "note": "15 dl vand. Gryden er kold, så barnet kan selv." } },
    { "@type": "HowToStep", "text": "Smuldr bouillonterningerne ned i gryden.", "tumbi": { "verbum": "smuldre", "ikoner": ["bouillon"] } },
    { "@type": "HowToStep", "text": "Kog suppen op.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "note": "Låg på og høj varme. Gryden på en bagerste plade, med håndtagene ind." } },
    { "@type": "HowToStep", "text": "Læg kyllingen i suppen.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["koed"], "note": "Hel filet. Den voksne lægger den forsigtigt i med en grydeske. Timeren startes efter håndvasken." } },
    { "@type": "HowToStep", "text": "Vask hænderne godt.", "tumbi": { "verbum": "vaske-haender", "note": "Med sæbe: rå kylling kan give maveonde." } },
    { "@type": "HowToStep", "text": "Lad kyllingen simre i 12 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 720, "note": "Svag varme, låg på." } },
    { "@type": "HowToStep", "text": "Kom suppeurter, ærter og gulerødder i.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["gulerod", "aerter"], "note": "Den voksne tager kyllingen op på en tallerken først: den skal være hvid hele vejen igennem. Grøntsagerne kommer direkte fra frost." } },
    { "@type": "HowToStep", "text": "Kog suppen i 5 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 300 } },
    { "@type": "HowToStep", "text": "Træk kyllingen fra hinanden med to gafler.", "tumbi": { "verbum": "smuldre", "voksen": true, "voksen_hjaelp": "varme", "note": "Kyllingen er varm. Barnet holder med den ene gaffel og trækker med den anden." } },
    { "@type": "HowToStep", "text": "Knæk nudlerne ned i gryden.", "tumbi": { "verbum": "smuldre", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["spaghetti"], "note": "Gryden er varm: den voksne holder øje, og barnet knækker fra kanten." } },
    { "@type": "HowToStep", "text": "Kog nudlerne i 3 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 180, "note": "Rør lidt, så de ikke klistrer." } },
    { "@type": "HowToStep", "text": "Kom kylling og majs i suppen.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["majs"], "note": "Gryden er varm: den voksne holder øje." } },
    { "@type": "HowToStep", "text": "Smag suppen til med salt.", "tumbi": { "verbum": "smage", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["salt"], "note": "Pust på skeen først." } }
  ],
