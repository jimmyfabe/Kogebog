  "name": "Tynde pandekager",
  "description": "Tynde pandekager efter en opskrift fra Tivoli.",
  "image": "grafik/ret-pandekager.webp",
  "inLanguage": "da",
  "recipeYield": "ca. 10-12 stk.",
  "prepTime": "PT10M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "200 g hvedemel",
    "5 dl mælk",
    "3 æg",
    "¼ tsk salt",
    "1 tsk sukker",
    "1 spsk olie",
    "50 g smør til panden"
  ],
  "tool": ["køkkenvægt", "stor skål", "piskeris", "dl-mål", "kop", "pande", "paletkniv"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Mål 200 g mel.", "tumbi": { "verbum": "maale", "ikoner": ["mel"], "note": "Brug køkkenvægten. 200 g mel er ca. 3,3 dl." } },
    { "@type": "HowToStep", "text": "Hæld melet i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["mel"] } },
    { "@type": "HowToStep", "text": "Mål 5 dl mælk.", "tumbi": { "verbum": "maale", "ikoner": ["maelk"] } },
    { "@type": "HowToStep", "text": "Pisk mel og mælk sammen.", "tumbi": { "verbum": "piske", "ikoner": ["mel", "maelk"], "note": "Hæld mælken i lidt ad gangen, så bliver der ingen klumper." } },
    { "@type": "HowToStep", "text": "Hæld salt, sukker og olie i.", "tumbi": { "verbum": "haelde", "ikoner": ["salt", "sukker", "olie"] } },
    { "@type": "HowToStep", "text": "Pisk æggene i dejen.", "tumbi": { "verbum": "piske", "ikoner": ["aeg"], "note": "Slå æggene ud i en kop først, så er det let at fiske skaller op. Æggene kommer i til sidst, så barnet ikke rører andet med æg på fingrene." } },
    { "@type": "HowToStep", "text": "Vask hænderne igen.", "tumbi": { "verbum": "vaske-haender", "note": "Med sæbe: der har været råt æg på fingrene." } },
    { "@type": "HowToStep", "text": "Steg pandekagen i smør.", "tumbi": { "verbum": "stege", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 60, "ikoner": ["smoer"], "note": "Middel varme og lidt smør på panden før hver pandekage. En lille øse dej. Steg den, til den er gylden." } },
    { "@type": "HowToStep", "text": "Vend pandekagen.", "tumbi": { "verbum": "vende", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 45, "note": "Vend, når kanten slipper panden. Gentag med resten af dejen." } },
    { "@type": "HowToStep", "text": "Smag en pandekage!", "tumbi": { "verbum": "smage", "note": "Lad den køle lidt først." } }
  ],
