  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Kog vand til nudlerne.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["vand"], "note": "2 l vand og 1 tsk salt i en stor gryde på en bagerste plade, med håndtagene ind. Med låg på koger det hurtigere." } },
    { "@type": "HowToStep", "text": "Ryst saucen sammen i et glas med låg.", "tumbi": { "verbum": "roere", "ikoner": ["soja", "honning", "vand"], "note": "Soja, honning og vand. Skru låget godt på." } },
    { "@type": "HowToStep", "text": "Hæld majsen i en si.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["majs"], "note": "Den voksne åbner dåserne: kanten er skarp. Resten af majsen kan gemmes i køleskabet." } },
    { "@type": "HowToStep", "text": "Læg kødet i gryden.", "tumbi": { "verbum": "stege", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["koed"], "note": "Olie i en stor gryde eller wok ved høj varme. Timeren startes efter håndvasken." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter råt kød." } },
    { "@type": "HowToStep", "text": "Brun kødet, og del det i små stykker.", "tumbi": { "verbum": "stege", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 240, "note": "Den voksne rører og deler kødet med grydeskeen." } },
    { "@type": "HowToStep", "text": "Hæld wokgrøntsagerne i gryden.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["broccoli"], "note": "Direkte fra frost. Den voksne hælder: olien er varm og kan sprøjte. Barnet står et skridt tilbage." } },
    { "@type": "HowToStep", "text": "Steg grøntsagerne med i 8 minutter.", "tumbi": { "verbum": "stege", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 480, "note": "Den voksne rører. Høj varme, til grøntsagerne er varme hele vejen igennem." } },
    { "@type": "HowToStep", "text": "Kom nudlerne i vandet.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 180, "ikoner": ["spaghetti"], "note": "Kog som anvist på posen, ca. 3 min." } },
    { "@type": "HowToStep", "text": "Hæld vandet fra nudlerne.", "tumbi": { "verbum": "si", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["spaghetti"], "note": "Den voksne hælder gennem dørslaget i vasken. Pas på dampen." } },
    { "@type": "HowToStep", "text": "Vend nudler og sauce i gryden.", "tumbi": { "verbum": "vende", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["spaghetti", "soja"], "note": "Den voksne vender det hele godt rundt." } },
    { "@type": "HowToStep", "text": "Drys majs over maden.", "tumbi": { "verbum": "drysse", "ikoner": ["majs"], "note": "På tallerkenerne." } }
