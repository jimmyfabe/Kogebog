  "recipeIngredient": [
    "2 ruller færdig pizzadej",
    "300 g tomatpassata",
    "300 g frossen hakket spinat",
    "300 g frossen broccoli",
    "1 tsk tørret oregano",
    "200 g revet ost",
    "1 agurk"
