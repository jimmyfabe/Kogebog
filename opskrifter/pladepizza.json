  "tool": ["2 bageplader", "gryde med låg", "si", "spiseske", "kniv", "skærebræt"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Varm spinat og broccoli i en gryde.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 300, "ikoner": ["spinat", "broccoli"], "note": "Tænd ovnen på 225 °C varmluft først. Middel varme, med låg. Rør et par gange, til det er tøet." } },
    { "@type": "HowToStep", "text": "Hæld grøntsagerne i en si.", "tumbi": { "verbum": "si", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["spinat", "broccoli"], "note": "Den voksne hælder. Tryk vandet ud med en ske, så pizzaen ikke bliver våd. Lad det køle lidt." } },
    { "@type": "HowToStep", "text": "Rul pizzadejen ud på pladerne.", "tumbi": { "verbum": "kagerulle", "ikoner": ["pizzadej"], "note": "Dejen ligger på sit eget bagepapir. Læg den på pladen med papiret under." } },
    { "@type": "HowToStep", "text": "Smør passataen ud på dejen.", "tumbi": { "verbum": "smoere", "ikoner": ["tomat"], "note": "Med bagsiden af en ske. Lad en lille kant være fri." } },
    { "@type": "HowToStep", "text": "Drys oregano over.", "tumbi": { "verbum": "drysse", "ikoner": ["krydderurt"] } },
    { "@type": "HowToStep", "text": "Fordel spinat og broccoli på pizzaerne.", "tumbi": { "verbum": "drysse", "ikoner": ["spinat", "broccoli"], "note": "Små klatter, så der kommer grønt over det hele." } },
    { "@type": "HowToStep", "text": "Drys osten over.", "tumbi": { "verbum": "drysse", "ikoner": ["ost"] } },
    { "@type": "HowToStep", "text": "Bag pizzaerne i ovnen i 15 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 900, "note": "225 °C varmluft. Begge plader kan bage på én gang. Bunden skal være gylden og osten smeltet." } },
    { "@type": "HowToStep", "text": "Tag pladerne ud af ovnen.", "tumbi": { "verbum": "tage-ud", "voksen": true, "voksen_hjaelp": "varme", "note": "Pladerne er meget varme." } },
    { "@type": "HowToStep", "text": "Skær agurken i stave.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["agurk"], "note": "Mens pizzaen køler lidt af." } },
    { "@type": "HowToStep", "text": "Skær pizzaen i firkanter.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "note": "Med et pizzahjul eller en stor kniv." } }
  ],
