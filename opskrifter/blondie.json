{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Blondie",
  "description": "Lys kage med brun farin, vanilje og stykker af hvid chokolade.",
  "image": "grafik/ret-blondie.svg",
  "inLanguage": "da",
  "recipeYield": "6 stykker (en lille form)",
  "prepTime": "PT20M",
  "cookTime": "PT25M",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "100 g smør, smeltet",
    "1,5 dl brun farin",
    "1 æg",
    "2 tsk vaniljesukker",
    "1,75 dl hvedemel",
    "½ tsk bagepulver",
    "75 g hvid chokolade, hakket"
  ],
  "tool": ["lille gryde", "kniv", "skærebræt", "stor skål", "grydeske", "dl-mål", "teske", "kop", "piskeris", "lille form", "bagepapir"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Smelt smørret i en lille gryde.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["smoer"], "note": "Lav varme. Tænd ovnen på 160 °C varmluft (175 °C almindelig ovn)." } },
    { "@type": "HowToStep", "text": "Hak den hvide chokolade.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["chokolade"], "note": "I små stykker." } },
    { "@type": "HowToStep", "text": "Mål 1,5 dl brun farin.", "tumbi": { "verbum": "maale", "ikoner": ["sukker"], "note": "Hæld den i en stor skål." } },
    { "@type": "HowToStep", "text": "Rør farin og smør sammen.", "tumbi": { "verbum": "roere", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["sukker", "smoer"], "note": "Den voksne hælder det varme smør i, og barnet rører." } },
    { "@type": "HowToStep", "text": "Kom vaniljesukkeret i.", "tumbi": { "verbum": "haelde", "ikoner": ["sukker"], "note": "2 tsk." } },
    { "@type": "HowToStep", "text": "Pisk ægget i.", "tumbi": { "verbum": "piske", "ikoner": ["aeg"], "note": "Slå ægget ud i en kop først, så er det let at fiske skaller op." } },
    { "@type": "HowToStep", "text": "Vask hænderne igen.", "tumbi": { "verbum": "vaske-haender", "note": "Med sæbe: der har været råt æg på fingrene." } },
    { "@type": "HowToStep", "text": "Mål 1,75 dl mel.", "tumbi": { "verbum": "maale", "ikoner": ["mel"] } },
    { "@type": "HowToStep", "text": "Rør mel og bagepulver forsigtigt i.", "tumbi": { "verbum": "roere", "ikoner": ["mel", "bagepulver"], "note": "½ tsk bagepulver. Har I ikke bagepulver, så spring det over: blondien bliver bare lidt fladere." } },
    { "@type": "HowToStep", "text": "Rør chokoladen i til sidst.", "tumbi": { "verbum": "roere", "ikoner": ["chokolade"] } },
    { "@type": "HowToStep", "text": "Hæld dejen i formen.", "tumbi": { "verbum": "haelde", "note": "Læg bagepapir i formen først. Dejen fylder en lille form, ca. en halv alubakke." } },
    { "@type": "HowToStep", "text": "Bag blondien i ovnen.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1200, "note": "20-25 min. Den skal være blød i midten: en tandstik skal komme op med fugtige krummer." } },
    { "@type": "HowToStep", "text": "Tag formen ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme" } },
    { "@type": "HowToStep", "text": "Lad blondien køle helt af.", "tumbi": { "verbum": "vente", "note": "Formen er meget varm." } },
    { "@type": "HowToStep", "text": "Skær kagen i 6 stykker.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv" } },
    { "@type": "HowToStep", "text": "Smag en bid!", "tumbi": { "verbum": "smage" } }
  ],
