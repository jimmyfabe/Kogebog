{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chokoladekage med krymmel",
  "description": "Stor, blød chokoladekage i bradepande med glasur og masser af krymmel. Den er god til fest.",
  "image": "grafik/ret-chokoladekage-med-krymmel.webp",
  "inLanguage": "da",
  "recipeYield": "24 stykker",
  "prepTime": "PT30M",
  "cookTime": "PT25M",
  "totalTime": "PT2H",
  "recipeIngredient": [
    "250 g smør",
    "4 dl sukker",
    "4 æg",
    "5 dl hvedemel",
    "5 spsk ren kakao",
    "3 tsk bagepulver",
    "2 tsk vaniljesukker",
    "2,5 dl mælk",
    "6 dl flormelis",
    "3 spsk ren kakao til glasuren",
    "5 spsk vand",
    "6 spsk farvet krymmel"
  ],
  "tool": ["bradepande (ca. 25×35 cm)", "bagepapir", "lille gryde", "stor skål", "kop", "elpisker eller piskeris", "dl-mål", "spiseske", "teske", "grydeske", "skål", "tandstik", "grydelapper", "kniv"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Tænd ovnen på 180 °C (alm. ovn), og læg bagepapir i bradepanden. Kagen indeholder gluten, æg og mælk. Tjek allergener på pakken med krymmel." } },
    { "@type": "HowToStep", "text": "Smelt smørret i en lille gryde.", "tumbi": { "verbum": "smelte", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["smoer"], "note": "En hel pakke (250 g). Ved lav varme." } },
    { "@type": "HowToStep", "text": "Lad smørret køle af i 10 minutter.", "tumbi": { "verbum": "vente", "timer_sek": 600, "note": "Det skal være lunt, ikke varmt, før det kommer i dejen." } },
    { "@type": "HowToStep", "text": "Mål sukkeret i en stor skål.", "tumbi": { "verbum": "maale", "ikoner": ["sukker"], "note": "4 dl." } },
    { "@type": "HowToStep", "text": "Slå æggene i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["aeg"], "note": "Slå dem ud i en kop først, så der ikke kommer skal i dejen." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter rå æg." } },
    { "@type": "HowToStep", "text": "Pisk æg og sukker luftigt i 3 minutter.", "tumbi": { "verbum": "piske", "timer_sek": 180, "note": "Med en elpisker eller et piskeris, til det er lyst. Med en elpisker hjælper den voksne lidt." } },
    { "@type": "HowToStep", "text": "Hæld mel, kakao, bagepulver og vaniljesukker i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["mel", "kakao", "bagepulver", "sukker"], "note": "5 dl mel, 5 spsk kakao, 3 tsk bagepulver og 2 tsk vaniljesukker." } },
    { "@type": "HowToStep", "text": "Hæld mælk og smør i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["maelk", "smoer"], "note": "2,5 dl mælk og det lune smør. Den voksne hælder smørret." } },
    { "@type": "HowToStep", "text": "Rør, til dejen er glat.", "tumbi": { "verbum": "roere" } },
    { "@type": "HowToStep", "text": "Hæld dejen i bradepanden.", "tumbi": { "verbum": "haelde" } },
    { "@type": "HowToStep", "text": "Vask hænderne igen.", "tumbi": { "verbum": "vaske-haender", "note": "Dejen har råt æg i: smag ikke på den." } },
    { "@type": "HowToStep", "text": "Bag kagen i 25 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1500, "note": "Midt i ovnen ved 180 °C. Den er færdig, når en tandstik kommer tør op." } },
    { "@type": "HowToStep", "text": "Tag bradepanden ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Med grydelapper. Bradepanden er meget varm." } },
    { "@type": "HowToStep", "text": "Lad kagen køle helt af.", "tumbi": { "verbum": "vente", "timer_sek": 2400, "note": "Ellers løber glasuren af." } },
    { "@type": "HowToStep", "text": "Rør flormelis, kakao og vand til glasur.", "tumbi": { "verbum": "roere", "ikoner": ["flormelis", "kakao", "vand"], "note": "6 dl flormelis, 3 spsk kakao og ca. 5 spsk vand. Kom vandet i lidt ad gangen: den skal være tyk, men kunne smøres. Der er ingen æg i." } },
    { "@type": "HowToStep", "text": "Smør glasuren ud på kagen.", "tumbi": { "verbum": "smoere", "ikoner": ["flormelis"], "note": "Med bagsiden af en ske." } },
    { "@type": "HowToStep", "text": "Drys krymmel over hele kagen.", "tumbi": { "verbum": "drysse", "ikoner": ["krymmel"], "note": "Mens glasuren er våd, så krymlen sidder fast." } },
    { "@type": "HowToStep", "text": "Lad glasuren stivne i 10 minutter.", "tumbi": { "verbum": "vente", "timer_sek": 600 } },
    { "@type": "HowToStep", "text": "Skær kagen i 24 stykker.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv" } },
    { "@type": "HowToStep", "text": "Smag festkagen!", "tumbi": { "verbum": "smage" } }
  ],
