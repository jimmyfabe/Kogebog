  "totalTime": "PT40M",
  "recipeIngredient": [
    "2 dl mælk",
    "½ tsk salt",
    "1 knivspids peber",
    "8 æg",
    "100 g bacon i tern",
    "300 g frosne ærter",
    "200 g frossen hakket spinat",
    "1 agurk",
    "8 skiver rugbrød"
  ],
  "tool": ["kande", "gaffel eller piskeris", "kop", "stort ovnfast fad", "grydelapper", "kniv", "skærebræt"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Pisk mælk, salt og peber i en kande.", "tumbi": { "verbum": "piske", "ikoner": ["maelk", "salt", "peber"], "note": "Tænd ovnen på 190 °C varmluft først." } },
    { "@type": "HowToStep", "text": "Pisk æggene i.", "tumbi": { "verbum": "piske", "ikoner": ["aeg"], "note": "Slå æggene ud i en kop først, så er det let at fiske skaller op." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter råt æg." } },
    { "@type": "HowToStep", "text": "Fordel baconen i et stort fad.", "tumbi": { "verbum": "drysse", "ikoner": ["koed"], "note": "Brug et fad, der kan tåle ovnen." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter råt kød." } },
    { "@type": "HowToStep", "text": "Drys ærter og spinat over baconen.", "tumbi": { "verbum": "drysse", "ikoner": ["aerter", "spinat"], "note": "Direkte fra frost, fra en skål." } },
    { "@type": "HowToStep", "text": "Hæld æggemassen over.", "tumbi": { "verbum": "haelde", "ikoner": ["aeg"], "note": "Fadet er koldt, så barnet kan selv. Rør let rundt med en gaffel." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter råt æg." } },
    { "@type": "HowToStep", "text": "Bag æggekagen i ovnen i 35 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 2100, "note": "190 °C varmluft. Fadet kommer koldt ind. Den er færdig, når midten er fast. Er midten blød, så 5 min mere." } },
    { "@type": "HowToStep", "text": "Tag fadet ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Fadet er meget varmt." } },
    { "@type": "HowToStep", "text": "Skær agurken i stave.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["agurk"] } },
    { "@type": "HowToStep", "text": "Læg rugbrød og agurk på tallerkenerne.", "tumbi": { "verbum": "pynte", "ikoner": ["broed", "agurk"] } }
  ],
