{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Hytteostboller",
  "description": "Grove boller med hytteost, havregryn og kerner. Uden gær og uden hævetid.",
  "image": "grafik/ret-hytteostboller.svg",
  "inLanguage": "da",
  "recipeYield": "10 boller",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "500 g hytteost",
    "400 g havregryn",
    "5 æg",
    "2 dl kerner, fx græskarkerner eller solsikkekerner",
    "1 tsk groft salt",
    "æg til pensling"
  ],
  "tool": ["køkkenvægt", "stor skål", "grydeske", "dl-mål", "kop", "gaffel", "pensel", "bageplade", "bagepapir", "rist"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Hæld hytteosten i en stor skål.", "tumbi": { "verbum": "haelde", "ikoner": ["hytteost"], "note": "Tænd ovnen på 200 °C varmluft." } },
    { "@type": "HowToStep", "text": "Mål 400 g havregryn.", "tumbi": { "verbum": "maale", "ikoner": ["havregryn"], "note": "Brug køkkenvægten." } },
    { "@type": "HowToStep", "text": "Hæld havregryn, kerner og salt i.", "tumbi": { "verbum": "haelde", "ikoner": ["havregryn", "kerner", "salt"], "note": "2 dl kerner, fx græskar- eller solsikkekerner." } },
    { "@type": "HowToStep", "text": "Slå de 5 æg i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["aeg"], "note": "Slå dem ud i en kop først, så er det let at fiske skaller op." } },
    { "@type": "HowToStep", "text": "Rør det hele sammen.", "tumbi": { "verbum": "roere", "note": "Til dejen er grov og hænger sammen." } },
    { "@type": "HowToStep", "text": "Form 10 boller på bagepapir.", "tumbi": { "verbum": "rulle", "note": "Læg dem på en bageplade med bagepapir. Våde hænder gør det lettere." } },
    { "@type": "HowToStep", "text": "Pensl bollerne med pisket æg.", "tumbi": { "verbum": "pensle", "ikoner": ["aeg"], "note": "Pisk ægget med en gaffel i en kop først." } },
    { "@type": "HowToStep", "text": "Vask hænderne godt.", "tumbi": { "verbum": "vaske-haender", "note": "Med sæbe: der har været råt æg på hænderne." } },
    { "@type": "HowToStep", "text": "Drys lidt flere kerner på.", "tumbi": { "verbum": "drysse", "ikoner": ["kerner"], "note": "Kan springes over." } },
    { "@type": "HowToStep", "text": "Bag bollerne i ovnen.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1500, "note": "200 °C varmluft i 25-30 min, til de er gyldne og gennembagte." } },
    { "@type": "HowToStep", "text": "Tag pladen ud af ovnen.", "tumbi": { "verbum": "tage-ud", "voksen": true, "voksen_hjaelp": "varme" } },
    { "@type": "HowToStep", "text": "Lad bollerne køle af på en rist.", "tumbi": { "verbum": "vente", "timer_sek": 600, "note": "Bagepladen er meget varm." } },
    { "@type": "HowToStep", "text": "Smag en bolle!", "tumbi": { "verbum": "smage" } }
  ],
