{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Mynte-lime-boble",
  "description": "Frisk og boblende med mynte, lime og æblemost. Pip, det lille pindsvin, siger, at den smager som en kold sommervind.",
  "image": "grafik/ret-mynte-lime-boble.webp",
  "inLanguage": "da",
  "recipeYield": "4 glas",
  "prepTime": "PT10M",
  "totalTime": "PT10M",
  "recipeIngredient": [
    "1 lime",
    "1 håndfuld frisk mynte",
    "2 spsk sukker",
    "4 dl æblemost (kold)",
    "8 isterninger",
    "4 dl danskvand (kold)"
  ],
  "tool": ["skærebræt", "kniv", "stor kande", "spiseske", "grydeske", "målebæger", "lang ske", "4 glas"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Sæt æblemost og danskvand på køl i god tid. Skyl limen og mynten. Isterningerne skal være lavet i forvejen, ellers springer I dem over." } },
    { "@type": "HowToStep", "text": "Skær limen over.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["lime"], "note": "Over på midten." } },
    { "@type": "HowToStep", "text": "Pluk myntebladene af stilkene.", "tumbi": { "verbum": "plukke", "ikoner": ["mynte"], "note": "Cirka 20 blade." } },
    { "@type": "HowToStep", "text": "Kom mynte og sukker i en stor kande.", "tumbi": { "verbum": "haelde", "ikoner": ["mynte", "sukker"], "note": "2 spsk sukker." } },
    { "@type": "HowToStep", "text": "Mos mynten med enden af en grydeske.", "tumbi": { "verbum": "mose", "ikoner": ["mynte"], "note": "Tryk bladene mod sukkeret, så de begynder at dufte. De skal ikke i stykker." } },
    { "@type": "HowToStep", "text": "Klem limen ud i kanden.", "tumbi": { "verbum": "klemme", "ikoner": ["lime"], "note": "Begge halvdele. Fisk kernerne op." } },
    { "@type": "HowToStep", "text": "Hæld æblemosten i kanden.", "tumbi": { "verbum": "haelde", "ikoner": ["aeble"], "note": "4 dl." } },
    { "@type": "HowToStep", "text": "Rør, til sukkeret er væk.", "tumbi": { "verbum": "roere", "note": "Med en lang ske." } },
    { "@type": "HowToStep", "text": "Læg to isterninger i hvert glas.", "tumbi": { "verbum": "pynte", "ikoner": ["isterninger"] } },
    { "@type": "HowToStep", "text": "Hæld danskvanden langsomt i kanden.", "tumbi": { "verbum": "haelde", "ikoner": ["danskvand"], "note": "4 dl, og lige før I skal drikke, så boblerne ikke forsvinder. Rør kun en enkelt gang." } },
    { "@type": "HowToStep", "text": "Hæld boblerne i glassene.", "tumbi": { "verbum": "haelde", "note": "Hæld langsomt ned ad siden af glasset, så det ikke skummer over. Myntebladene må gerne følge med." } },
    { "@type": "HowToStep", "text": "Smag mynte-lime-boblen!", "tumbi": { "verbum": "smage" } }
  ],
  "tumbi": {
    "id": "mynte-lime-boble",
    "version": 1,
    "afproevet": false,
    "kilde": "Egen opskrift, der ikke er smagt til: mængderne er et skøn. Trinene er egen tekst.",
    "ingredienser": [
      { "ikon": "lime", "maengde": "1" },
      { "ikon": "mynte", "maengde": "1" },
      { "ikon": "sukker", "maengde": "2 spsk" },
      { "ikon": "aeble", "maengde": "4 dl" },
      { "ikon": "isterninger", "maengde": "8" },
      { "ikon": "danskvand", "maengde": "4 dl" }
    ]
  }
}
