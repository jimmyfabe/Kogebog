  "tool": ["dåseåbner", "si", "bradepande", "grydelapper", "2 gafler", "bagepapir", "skåle"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Hæld majsen i en si.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["majs"], "note": "Den voksne åbner dåsen: kanten er skarp. Lad vandet løbe fra." } },
    { "@type": "HowToStep", "text": "Hæld grøntsagerne i en bradepande.", "tumbi": { "verbum": "haelde", "ikoner": ["aerter", "olie"], "note": "Tænd ovnen på 220 °C varmluft først. Direkte fra frost. Dryp 2 spsk olie over." } },
    { "@type": "HowToStep", "text": "Læg kyllingen oven på grøntsagerne.", "tumbi": { "verbum": "pynte", "ikoner": ["koed"], "note": "Hele fileter." } },
    { "@type": "HowToStep", "text": "Vask hænderne godt.", "tumbi": { "verbum": "vaske-haender", "note": "Med sæbe: rå kylling kan give maveonde." } },
    { "@type": "HowToStep", "text": "Drys krydderiet over det hele.", "tumbi": { "verbum": "drysse", "ikoner": ["krydderurt"], "note": "Fra en lille skål, uden at røre kyllingen." } },
    { "@type": "HowToStep", "text": "Bag det hele i ovnen i 25 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1500, "note": "220 °C varmluft." } },
    { "@type": "HowToStep", "text": "Tag bradepanden ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Den er meget varm. Den voksne deler den tykkeste filet med en gaffel: er den lyserød indeni, så 5 min mere i ovnen." } },
    { "@type": "HowToStep", "text": "Pak tortillaerne ind i bagepapir.", "tumbi": { "verbum": "pakke-ind", "ikoner": ["tortilla"] } },
    { "@type": "HowToStep", "text": "Lun tortillaerne i ovnen i 3 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 180, "note": "Ovnen er stadig varm." } },
    { "@type": "HowToStep", "text": "Tag tortillaerne ud af ovnen.", "tumbi": { "verbum": "tage-ud", "voksen": true, "voksen_hjaelp": "varme", "note": "Pakken er varm." } },
    { "@type": "HowToStep", "text": "Træk kyllingen fra hinanden med to gafler.", "tumbi": { "verbum": "smuldre", "voksen": true, "voksen_hjaelp": "varme", "note": "Kyllingen er varm. Barnet holder med den ene gaffel og trækker med den anden." } },
    { "@type": "HowToStep", "text": "Byg din egen fajita.", "tumbi": { "verbum": "rulle", "ikoner": ["tortilla", "majs", "yoghurt", "ost"], "note": "Kylling og grønt, majs, en klat yoghurt og ost. Rul tortillaen sammen." } }
