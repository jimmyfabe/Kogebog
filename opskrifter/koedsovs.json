    { "@type": "HowToStep", "text": "Lad sovsen småkoge i 20 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1200, "note": "Lav varme og låg halvt på. Rør af og til." } },
