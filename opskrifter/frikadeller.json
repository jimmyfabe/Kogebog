  "name": "Frikadeller",
  "description": "Saftige frikadeller. Server dem med kartofler og grønt.",
  "image": "grafik/ret-frikadeller.svg",
  "inLanguage": "da",
  "recipeYield": "4 personer (ca. 16 stk.)",
  "prepTime": "PT15M",
