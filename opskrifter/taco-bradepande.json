  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Hæld bønner og majs i en si.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["boenner", "majs"], "note": "Tænd ovnen på 200 °C varmluft først. Den voksne åbner dåserne: kanten er skarp. Skyl dem med koldt vand." } },
    { "@type": "HowToStep", "text": "Hæld bønner og majs i fadet.", "tumbi": { "verbum": "haelde", "ikoner": ["boenner", "majs"] } },
    { "@type": "HowToStep", "text": "Hæld tomaterne i fadet.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["tomat"], "note": "Den voksne åbner dåserne: kanten er skarp." } },
    { "@type": "HowToStep", "text": "Hæld det frosne grønt i fadet.", "tumbi": { "verbum": "haelde", "ikoner": ["aerter"], "note": "Direkte fra frost." } },
    { "@type": "HowToStep", "text": "Drys tacokrydderiet over.", "tumbi": { "verbum": "drysse", "ikoner": ["krydderurt"] } },
    { "@type": "HowToStep", "text": "Rør det hele godt sammen.", "tumbi": { "verbum": "roere" } },
    { "@type": "HowToStep", "text": "Del tortillaerne i små stykker.", "tumbi": { "verbum": "smuldre", "ikoner": ["tortilla"], "note": "Med hænderne. Stykker på størrelse med en tændstikæske." } },
    { "@type": "HowToStep", "text": "Stik stykkerne ned i fadet.", "tumbi": { "verbum": "pynte", "ikoner": ["tortilla"], "note": "Lidt ned i blandingen, så kanterne stikker op og bliver sprøde." } },
    { "@type": "HowToStep", "text": "Drys osten over.", "tumbi": { "verbum": "drysse", "ikoner": ["ost"] } },
    { "@type": "HowToStep", "text": "Bag fadet i ovnen i 20 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1200, "note": "200 °C varmluft, midt i ovnen. Osten skal være smeltet og gylden." } },
    { "@type": "HowToStep", "text": "Tag fadet ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Fadet er meget varmt. Stil det på en bordskåner." } },
    { "@type": "HowToStep", "text": "Kom yoghurten i en lille skål.", "tumbi": { "verbum": "haelde", "ikoner": ["yoghurt"], "note": "Hver tager selv en klat på maden. Lad maden køle lidt først." } }
  ],
