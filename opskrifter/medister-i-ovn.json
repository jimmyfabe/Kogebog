    { "@type": "HowToStep", "text": "Bag det hele i ovnen i 20 minutter mere.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 1200, "note": "200 °C varmluft." } },
    { "@type": "HowToStep", "text": "Tag bradepanden ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Medisteren skal være stegt hele vejen igennem: kødsaften er klar, og den er ikke lyserød indeni." } },
