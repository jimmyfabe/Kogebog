  "tool": ["dåseåbner", "si", "køkkenvægt", "gryde med låg", "grydeske"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Hæld kidneybønnerne i en si.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["boenner"], "note": "Den voksne åbner dåserne: kanten er skarp. Skyl dem med koldt vand." } },
    { "@type": "HowToStep", "text": "Mål 150 g suppehorn.", "tumbi": { "verbum": "maale", "ikoner": ["spaghetti"], "note": "Brug køkkenvægten." } },
    { "@type": "HowToStep", "text": "Hæld suppeurter og grønne bønner i en gryde.", "tumbi": { "verbum": "haelde", "ikoner": ["gulerod", "boenner"], "note": "Direkte fra frost. Gryden er kold, så barnet kan selv." } },
    { "@type": "HowToStep", "text": "Hæld tomaterne i gryden.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["tomat"], "note": "Gryden er kold. Den voksne åbner dåserne: kanten er skarp." } },
    { "@type": "HowToStep", "text": "Hæld vand i gryden.", "tumbi": { "verbum": "haelde", "ikoner": ["vand"] } },
    { "@type": "HowToStep", "text": "Smuldr bouillonterningen ned i gryden.", "tumbi": { "verbum": "smuldre", "ikoner": ["bouillon"] } },
    { "@type": "HowToStep", "text": "Kog suppen under låg i 10 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 600, "note": "Middel varme. Timeren startes, når suppen koger." } },
    { "@type": "HowToStep", "text": "Hæld suppehorn og kidneybønner i suppen.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["spaghetti", "boenner"], "note": "Gryden er varm: barnet hælder fra en skål, og den voksne holder øje." } },
    { "@type": "HowToStep", "text": "Kog suppen i 10 minutter mere.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 600, "note": "Rør af og til, så suppehornene ikke sætter sig i bunden." } },
    { "@type": "HowToStep", "text": "Smag suppen til med salt og peber.", "tumbi": { "verbum": "smage", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["salt", "peber"], "note": "Pust på skeen først." } },
    { "@type": "HowToStep", "text": "Drys ost over suppen.", "tumbi": { "verbum": "drysse", "ikoner": ["ost"], "note": "På tallerkenerne." } }
  ],
