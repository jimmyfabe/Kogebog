{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Gulerodskage",
  "description": "Saftig kage med gulerod og lidt kanel, og blød flødeostcreme på toppen.",
  "image": "grafik/ret-gulerodskage.webp",
  "inLanguage": "da",
  "recipeYield": "12 stykker",
  "prepTime": "PT30M",
  "cookTime": "PT35M",
  "totalTime": "PT2H20M",
  "recipeIngredient": [
    "4 gulerødder",
    "2,5 dl sukker",
    "1,5 dl neutral olie",
    "3 æg",
    "4 dl hvedemel",
    "3 tsk bagepulver",
    "2 tsk kanel",
    "2 tsk vaniljesukker",
    "200 g flødeost",
    "50 g blødt smør",
    "3 dl flormelis"
  ],
  "tool": ["form (ca. 20×30 cm)", "bagepapir", "kartoffelskræller", "rivejern", "stor skål", "dl-mål", "kop", "elpisker eller piskeris", "teske", "grydeske", "tandstik", "grydelapper", "skål", "ske", "kniv"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Tænd ovnen på 175 °C (alm. ovn), og læg bagepapir i formen. Tag smørret ud af køleskabet, så det er blødt til cremen. Kagen indeholder gluten, æg og mælk." } },
    { "@type": "HowToStep", "text": "Skræl gulerødderne.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["gulerod"], "note": "Med en kartoffelskræller." } },
    { "@type": "HowToStep", "text": "Riv gulerødderne groft.", "tumbi": { "verbum": "rive", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["gulerod"], "note": "Det er ca. 300 g." } },
    { "@type": "HowToStep", "text": "Mål sukker og olie i en stor skål.", "tumbi": { "verbum": "maale", "ikoner": ["sukker", "olie"], "note": "2,5 dl sukker og 1,5 dl olie." } },
    { "@type": "HowToStep", "text": "Slå æggene i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["aeg"], "note": "Slå dem ud i en kop først, så der ikke kommer skal i dejen." } },
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender", "note": "Efter rå æg." } },
    { "@type": "HowToStep", "text": "Pisk det sammen i 2 minutter.", "tumbi": { "verbum": "piske", "timer_sek": 120, "note": "Til det er lyst og godt blandet. Med en elpisker hjælper den voksne lidt." } },
    { "@type": "HowToStep", "text": "Hæld mel, bagepulver, kanel og vaniljesukker i skålen.", "tumbi": { "verbum": "haelde", "ikoner": ["mel", "bagepulver", "krydderi", "sukker"], "note": "4 dl mel, 3 tsk bagepulver, 2 tsk kanel og 2 tsk vaniljesukker." } },
    { "@type": "HowToStep", "text": "Rør gulerødderne i dejen.", "tumbi": { "verbum": "roere", "ikoner": ["gulerod"], "note": "Rør kun, til melet er væk." } },
    { "@type": "HowToStep", "text": "Hæld dejen i formen.", "tumbi": { "verbum": "haelde" } },
    { "@type": "HowToStep", "text": "Vask hænderne igen.", "tumbi": { "verbum": "vaske-haender", "note": "Dejen har råt æg i: smag ikke på den." } },
    { "@type": "HowToStep", "text": "Bag kagen i 35 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 2100, "note": "Midt i ovnen ved 175 °C. Den er færdig, når en tandstik kommer tør op." } },
    { "@type": "HowToStep", "text": "Tag formen ud af ovnen.", "tumbi": { "verbum": "tage-ud-form", "voksen": true, "voksen_hjaelp": "varme", "note": "Med grydelapper. Formen er meget varm." } },
    { "@type": "HowToStep", "text": "Lad kagen køle helt af.", "tumbi": { "verbum": "vente", "timer_sek": 3600, "note": "Ellers løber cremen af." } },
    { "@type": "HowToStep", "text": "Rør flødeost, smør og flormelis til creme.", "tumbi": { "verbum": "roere", "ikoner": ["flodeost", "smoer", "flormelis"], "note": "200 g flødeost, 50 g blødt smør og 3 dl flormelis. Rør kun, til den er glat: så bliver den ikke tynd. Der er ingen æg i." } },
    { "@type": "HowToStep", "text": "Smør cremen på kagen.", "tumbi": { "verbum": "smoere", "ikoner": ["flodeost"] } },
    { "@type": "HowToStep", "text": "Skær kagen i 12 stykker.", "tumbi": { "verbum": "skaere", "voksen": true, "voksen_hjaelp": "kniv" } },
    { "@type": "HowToStep", "text": "Smag gulerodskagen!", "tumbi": { "verbum": "smage", "note": "Gem resten i køleskabet: der er flødeost i cremen." } }
  ],
