  "@type": "Recipe",
  "name": "Tomatsuppe med hvide bønner og croutoner",
  "description": "Jævn tomatsuppe med suppeurter og hvide bønner. Sprøde croutoner fra ovnen på toppen.",
  "image": "grafik/ret-tomatsuppe-med-boenner.webp",
  "inLanguage": "da",
  "recipeYield": "4 personer",
