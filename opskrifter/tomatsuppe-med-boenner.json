  "recipeIngredient": [
    "150 g toastbrød",
    "2 spsk olie",
    "500 g tomatpassata",
    "2 dåser hakkede tomater",
    "300 g frosne suppeurter",
    "4 dl vand",
    "1 grøntsagsbouillonterning",
    "1 dåse hvide bønner i tomat",
    "100 g creme fraiche",
    "½ tsk salt"
  ],
  "tool": ["bageplade", "bagepapir", "frysepose", "dåseåbner", "gryde med låg", "grydeske"],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Vask hænderne.", "tumbi": { "verbum": "vaske-haender" } },
    { "@type": "HowToStep", "text": "Del brødet i små stykker.", "tumbi": { "verbum": "smuldre", "ikoner": ["broed"], "note": "Tænd ovnen på 200 °C varmluft først. Med hænderne: stykker på størrelse med en terning." } },
    { "@type": "HowToStep", "text": "Ryst brødet med olie i en pose.", "tumbi": { "verbum": "roere", "ikoner": ["broed", "olie"], "note": "Hold godt om posen." } },
    { "@type": "HowToStep", "text": "Hæld brødet ud på en plade.", "tumbi": { "verbum": "haelde", "ikoner": ["broed"], "note": "Bagepapir på pladen." } },
    { "@type": "HowToStep", "text": "Hæld passata, tomater og suppeurter i en gryde.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "kniv", "ikoner": ["tomat", "gulerod"], "note": "Gryden er kold. Den voksne åbner dåserne: kanten er skarp." } },
    { "@type": "HowToStep", "text": "Hæld vand i gryden.", "tumbi": { "verbum": "haelde", "ikoner": ["vand"] } },
    { "@type": "HowToStep", "text": "Smuldr bouillonterningen ned i gryden.", "tumbi": { "verbum": "smuldre", "ikoner": ["bouillon"] } },
    { "@type": "HowToStep", "text": "Kog suppen op under låg.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "note": "Middel varme." } },
    { "@type": "HowToStep", "text": "Bag brødet i ovnen i 8 minutter.", "tumbi": { "verbum": "bage", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 480, "note": "200 °C varmluft. Rør i suppen en gang imens." } },
    { "@type": "HowToStep", "text": "Tag pladen ud af ovnen.", "tumbi": { "verbum": "tage-ud", "voksen": true, "voksen_hjaelp": "varme", "note": "Croutonerne skal være gyldne og sprøde." } },
    { "@type": "HowToStep", "text": "Hæld bønnerne i suppen.", "tumbi": { "verbum": "haelde", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["boenner"], "note": "Gryden er varm. Den voksne åbner dåserne: kanten er skarp. Tomatsovsen kommer med i suppen." } },
    { "@type": "HowToStep", "text": "Lad suppen småkoge i 5 minutter.", "tumbi": { "verbum": "koge", "voksen": true, "voksen_hjaelp": "varme", "timer_sek": 300 } },
    { "@type": "HowToStep", "text": "Rør creme fraiche i suppen.", "tumbi": { "verbum": "roere", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["yoghurt"], "note": "Tag gryden af varmen først." } },
    { "@type": "HowToStep", "text": "Smag suppen til med salt.", "tumbi": { "verbum": "smage", "voksen": true, "voksen_hjaelp": "varme", "ikoner": ["salt"], "note": "Pust på skeen først." } },
    { "@type": "HowToStep", "text": "Drys croutoner over suppen.", "tumbi": { "verbum": "drysse", "ikoner": ["broed"], "note": "På tallerkenerne." } }
  ],
